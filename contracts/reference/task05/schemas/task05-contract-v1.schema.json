        "is_primary",
        "request_sequence",
        "direction",
        "detected_at_ns",
        "detected_device_id",
        "detected_interface_id",
        "trigger_event_id",
        "evidence_completeness",
        "facts"
      ],
      "additionalProperties": false
    },
