    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "error_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "test_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_class": {
          "enum": [
            "COMMAND_INVALID",
            "REFERENCE_INVALID",
            "SNAPSHOT_INVALID",
            "VERSION_UNSUPPORTED",
            "PRECONDITION_CONFLICT",
            "PERSISTENCE_FAILURE",
            "CONTRACT_FAILURE"
          ]
        },
        "code": {
          "enum": [
            "MALFORMED_PING_COMMAND",
            "INVALID_COMMAND_FIELD",
            "UNKNOWN_PROJECT",
            "UNKNOWN_SOURCE_DEVICE",
            "UNKNOWN_DESTINATION_DEVICE",
            "UNSUPPORTED_PING_SOURCE",
            "UNSUPPORTED_PING_DESTINATION",
            "CROSS_PROJECT_REFERENCE",
            "MISSING_SNAPSHOT",
            "SNAPSHOT_REVISION_MISMATCH",
            "SNAPSHOT_DIGEST_MISMATCH",
            "UNSUPPORTED_MODEL_SCHEMA_VERSION",
            "UNSUPPORTED_CONTRACT_VERSION",
            "REQUEST_PRECONDITION_CONFLICT",
            "PERSISTENCE_UNAVAILABLE",
            "CONTRACT_PROCESSING_ERROR"
          ]
        },
        "message_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          }
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapshotRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "error_id",
        "project_id",
        "test_id",
        "error_class",
        "code",
        "message_key",
        "details",
        "snapshot_ref",
        "retryable"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "error_class": {
                "const": "COMMAND_INVALID"
              }
            },
            "required": [
              "error_class"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "MALFORMED_PING_COMMAND",
                  "INVALID_COMMAND_FIELD"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error_class": {
                "const": "REFERENCE_INVALID"
              }
            },
            "required": [
              "error_class"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "UNKNOWN_PROJECT",
                  "UNKNOWN_SOURCE_DEVICE",
                  "UNKNOWN_DESTINATION_DEVICE",
                  "UNSUPPORTED_PING_SOURCE",
                  "UNSUPPORTED_PING_DESTINATION",
                  "CROSS_PROJECT_REFERENCE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error_class": {
                "const": "SNAPSHOT_INVALID"
              }
            },
            "required": [
              "error_class"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "MISSING_SNAPSHOT",
                  "SNAPSHOT_REVISION_MISMATCH",
                  "SNAPSHOT_DIGEST_MISMATCH"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error_class": {
                "const": "VERSION_UNSUPPORTED"
              }
            },
            "required": [
              "error_class"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "UNSUPPORTED_MODEL_SCHEMA_VERSION",
                  "UNSUPPORTED_CONTRACT_VERSION"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error_class": {
                "const": "PRECONDITION_CONFLICT"
              }
            },
            "required": [
              "error_class"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "REQUEST_PRECONDITION_CONFLICT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error_class": {
                "const": "PERSISTENCE_FAILURE"
              }
            },
            "required": [
              "error_class"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "PERSISTENCE_UNAVAILABLE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error_class": {
                "const": "CONTRACT_FAILURE"
              }
            },
            "required": [
              "error_class"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "CONTRACT_PROCESSING_ERROR"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
