# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Environment configuration and secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# Build artifacts
build/
dist/
.coverage
htmlcov/

# Local AI model files
models/
*.gguf
*.safetensors
# TASK-06 ORM source is not a local AI model directory.
!app/db/models/
!app/db/models/**
app/db/models/__pycache__/

# Local development database (scripts/dev_db.py)
.pgdata/

# Logs
*.log
logs/
# TASK-06 durable-log source is application code, not generated logs.
!app/modules/logs/
!app/modules/logs/**
app/modules/logs/__pycache__/
